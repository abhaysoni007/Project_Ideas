# Copy this file to .env and fill in values. Never commit .env.

# --- Required ---
# GitHub personal access token with 'repo' scope.
# Create at: https://github.com/settings/tokens  (classic) or fine-grained token
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email that is VERIFIED on your GitHub account.
# Contributions only count when the commit email matches your account.
GIT_AUTHOR_EMAIL=you@example.com

# --- Usually fine as defaults ---
GITHUB_USERNAME=abhaysoni007
GITHUB_REPO=Project_Ideas
GIT_BRANCH=main
GIT_AUTHOR_NAME=abhaysoni007

# How many idea commits per day (random between min and max). A daily work-log
# commit is added on top, so total commits = this + 1.
# Weekdays (Mon-Fri) use MIN/MAX_COMMITS; weekends (Sat/Sun) use the smaller
# WEEKEND range so activity looks natural. No skip days — weekends still commit.
MIN_COMMITS=15
MAX_COMMITS=30
WEEKEND_MIN=6
WEEKEND_MAX=12

# Where the repo gets cloned locally.
# WORK_DIR=C:\Users\yuvra\Downloads\OppoEnco2\ai automation\repo_workspace

# --- Optional: FREE AI-generated ideas (no credit card) ---
# Get a free Groq key at https://console.groq.com/keys and paste it below.
# Leave blank to use the built-in local idea generator (no key, no network).
# Works with any OpenAI-compatible API (Groq, OpenRouter, Together, ...).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
