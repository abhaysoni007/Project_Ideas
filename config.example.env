# Copy this file to .env and fill in values. Never commit .env.

# --- Required ---
# GitHub personal access token with 'repo' scope.
# Create at: https://github.com/settings/tokens  (classic) or fine-grained token
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email that is VERIFIED on your GitHub account.
# Contributions only count when the commit email matches your account.
GIT_AUTHOR_EMAIL=you@example.com

# --- Usually fine as defaults ---
GITHUB_USERNAME=abhaysoni007
GITHUB_REPO=Project_Ideas
GIT_BRANCH=main
GIT_AUTHOR_NAME=abhaysoni007

# How many commits per day (random between min and max).
MIN_COMMITS=5
MAX_COMMITS=6

# Where the repo gets cloned locally.
# WORK_DIR=C:\Users\yuvra\Downloads\OppoEnco2\ai automation\repo_workspace

# --- Optional: real AI-generated ideas via Claude ---
# Leave blank to use the built-in local idea generator (no API cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
